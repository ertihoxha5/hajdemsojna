# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
build-final.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database — SQLite lives at the repo root in dev and under /prisma when the
# Prisma CLI creates it; both are real user data and neither belongs in git.
*.db
*.db-journal
*.db-wal
*.db-shm
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# generated prisma client
/src/generated

# uploaded user files (private, served only through an authorised route)
/storage
